#version 460 core

in GS_OUT
{
    vec3 pos;
    vec3 normal;
} fsIn;

layout(location = 0) out vec4 fragColor;

void main() {
    vec3 shadeDir = normalize(vec3(0.2,0.5,1));
    float light = (dot(fsIn.normal, shadeDir) + 1) * 0.5;
    fragColor = vec4(light.xx, 0, 1);
    fragColor = vec4(fsIn.normal * 0.5 + vec3(0.5,0.5,0.5), 1);
}