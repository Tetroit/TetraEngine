#version 460

layout (location = 0) in vec4 aPos;
layout (location = 1) in vec4 aNormal;
layout (location = 2) in vec4 aColor;

uniform mat4 transform;
uniform mat4 view;
uniform mat4 projection;

struct Vertex4D {
    vec4 pos;
    vec4 normal;
    vec4 color;
};
out VS_OUT{
    Vertex4D vert;
} vsOut;

void main() {
    vsOut.vert.pos = aPos;
    vsOut.vert.color = aColor;
    vsOut.vert.normal = aNormal;
    gl_Position = projection * view * vsOut.vert.pos;
}