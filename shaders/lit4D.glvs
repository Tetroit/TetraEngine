#version 460

layout (location = 0) in vec4 aPos;
layout (location = 1) in vec4 aNormal;
layout (location = 2) in vec4 aColor;

uniform mat4 transform;
uniform mat4 view;
uniform mat4 projection;

uniform mat4 rotation4D = mat4(1);
uniform vec4 translation4D = vec4(0);

struct Vertex4D {
    vec4 pos;
    vec4 normal;
    vec4 color;
};
out VS_OUT{
    Vertex4D vert;
} vsOut;

void main() {
    vsOut.vert.pos = rotation4D * aPos + translation4D;
    vsOut.vert.color = aColor;
    vsOut.vert.normal = rotation4D * aNormal;
    gl_Position = projection * view * vsOut.vert.pos;
}