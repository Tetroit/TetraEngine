#version 460

layout (location = 0) in vec4 aPos;

uniform mat4 transform;
uniform mat4 view;
uniform mat4 projection;
uniform float minW;
uniform float maxW;

vec3 colorMap(float t)
{
    t = (t - minW) / (maxW - minW);
    t = clamp(t, 0.0, 1.0);

    return mix(vec3(1,0.5,0), vec3(0,0.5,1), t);
}

out vec3 color;
void main() {
    gl_Position = projection * view * transform * vec4(aPos.xyz, 1);
    color = colorMap(aPos.w);
}